DATABASE_URL=[FILL IN: Supabase PostgreSQL connection string]
SUPABASE_URL=[FILL IN: Supabase URL]
SUPABASE_SERVICE_ROLE_KEY=[FILL IN: Supabase service role key]

JWT_SECRET_KEY=[FILL IN: JWT secret]
JWT_ALGORITHM=HS256

AI_API_KEY=[FILL IN: AI provider API key]
AI_MODEL=[FILL IN: AI model]

IGOT_API_BASE_URL=[FILL IN: iGOT API URL]
IGOT_CLIENT_ID=[FILL IN: iGOT client ID]
IGOT_CLIENT_SECRET=[FILL IN: iGOT client secret]

DEV_BYPASS_KEY=[FILL IN: Development-only bypass key]
